# 后端配置模板。复制为 .env.dev（本地）或 .env.prod（生产）后填写。
# 由 SPRING_CONFIG_IMPORT 导入，例如 file:../.env.dev[.properties]。
# 格式为 Java Properties：键=值，值直接写在等号后，字面反斜杠写成 \\。

# ===== 数据库（必填） =====
# 本环境的 MySQL 8.4 库；库和账号使用 utf8mb4，并授予该库的读写及迁移权限。
DB_URL=jdbc:mysql://127.0.0.1:3306/jh_emp_dev
DB_USER=root
DB_PASSWORD=

# ===== 服务（必填） =====
# 本地监听地址，仅本机可访问时用 127.0.0.1。
SERVER_ADDRESS=127.0.0.1
# 是否开放 /api/openapi 供前端生成接口类型。
OPENAPI_ENABLED=false

# ===== 管理员账号 =====
# 账号表为空时用于创建管理员的登录名和初始密码。
EMP_ADMIN_USER=admin
EMP_ADMIN_PASSWORD=

# ===== 存储 =====
# 附件目录，不存在时自动创建。Windows 路径用正斜杠。
EMP_UPLOAD_DIR=./data/uploads
# 日志目录，后端统一写入该目录下的 backend.log。
EMP_LOG_DIR=./data/logs

# ===== 日志 =====
EMP_LOG_LEVEL=INFO
EMP_LOG_MAX_FILE_SIZE=100MB
EMP_LOG_MAX_HISTORY_DAYS=60
EMP_LOG_TOTAL_SIZE_CAP=10GB
# 超过该毫秒数的请求记为慢请求。
EMP_LOG_SLOW_REQUEST_MS=1000
# 取客户端 IP 的请求头；直连用 X-Forwarded-For，经 Cloudflare 用 CF-Connecting-IP。
EMP_CLIENT_IP_HEADER=CF-Connecting-IP

# ===== 安全 =====
# 身份证、银行卡、手机号等敏感字段的加密密钥，格式 v1:<32 字节 base64>，多个版本用逗号分隔。
# 丢失后这些字段无法解密，需与数据库备份分开保存。
PII_KEYS=
# 验证码邮件发信密钥；留空时 dev 把验证码打印到后端日志。
RESEND_API_KEY=

# ===== 附件孤儿清理 =====
# 每天清理超过保留期且无人引用的附件。默认只统计不删除，观察期结束后改为 false，见 docs/attachments.md。
EMP_ATTACHMENT_ORPHAN_DRY_RUN=true
# 保留期，单位小时。
EMP_ATTACHMENT_ORPHAN_RETENTION_HOURS=48
# 执行时间与批处理上限。
EMP_ATTACHMENT_ORPHAN_CRON=0 0 3 * * *
EMP_ATTACHMENT_ORPHAN_BATCH_SIZE=500
EMP_ATTACHMENT_ORPHAN_MAX_BATCHES=20
